# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase -------------------------------------------------------------
# Local (supabase start prints these):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Hosted: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by the publish/broadcast action, the escrow
# transition function and the Stripe webhook. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (test mode only) ----------------------------------------------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
